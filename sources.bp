// BoringSSL source lists for Soong, written directly as filegroups.
//
// Each filegroup below mirrors one list in upstream's pregenerated
// src/gen/sources.json, using globs so that files upstream adds are picked up
// without a regeneration step. boringssl_sources_test (in sources_test.bp)
// fails if a filegroup and upstream's list ever disagree, e.g. after upstream
// moves or adds files in a way the globs don't capture.

filegroup {
    name: "boringssl_bcm_srcs",
    srcs: ["src/crypto/fipsmodule/bcm.cc"],
}

filegroup {
    name: "boringssl_bcm_asm",
    srcs: [
        "src/gen/bcm/*.S",
        "src/third_party/fiat/asm/fiat_p256_adx_*.S",
    ],
}

filegroup {
    name: "boringssl_crypto_srcs",
    srcs: [
        "src/crypto/**/*.cc",
        "src/gen/crypto/*.cc",
    ],
    exclude_srcs: [
        "src/crypto/**/*_test.cc",
        "src/crypto/test/**/*",
        "src/crypto/fipsmodule/bcm.cc",
        "src/crypto/rand/passive.cc",
    ],
}

filegroup {
    name: "boringssl_crypto_asm",
    srcs: [
        "src/gen/crypto/*.S",
        "src/crypto/**/asm/*.S",
        "src/crypto/poly1305/poly1305_arm_asm.S",
        "src/third_party/fiat/asm/fiat_curve25519_adx_*.S",
    ],
}

filegroup {
    name: "boringssl_test_support_srcs",
    srcs: ["src/crypto/test/*.cc"],
    exclude_srcs: ["src/crypto/test/gtest_main.cc"],
}

filegroup {
    name: "boringssl_test_support_asm",
    srcs: ["src/gen/test_support/*.S"],
}

filegroup {
    name: "boringssl_ssl_srcs",
    srcs: ["src/ssl/*.cc"],
    exclude_srcs: ["src/ssl/*_test.cc"],
}

filegroup {
    name: "boringssl_bssl_srcs",
    srcs: ["src/tool/*.cc"],
}

filegroup {
    name: "boringssl_pki_srcs",
    srcs: ["src/pki/*.cc"],
    exclude_srcs: [
        "src/pki/*_unittest.cc",
        "src/pki/mock_signature_verify_cache.cc",
        "src/pki/test_helpers.cc",
    ],
}

filegroup {
    name: "boringssl_crypto_test_srcs",
    srcs: [
        "src/crypto/**/*_test.cc",
        "src/crypto/test/gtest_main.cc",
        "src/third_party/fiat/bedrock_platform_test.cc",
    ],
    exclude_srcs: [
        "src/crypto/rand/urandom_test.cc",
        "src/crypto/test/abi_test.cc",
        "src/crypto/test/file_test.cc",
    ],
}

filegroup {
    name: "boringssl_ssl_test_srcs",
    srcs: [
        "src/ssl/*_test.cc",
        "src/ssl/ssl_c_test.c",
        "src/crypto/test/gtest_main.cc",
    ],
}

cc_defaults {
    name: "libcrypto_sources",
    srcs: [":boringssl_crypto_srcs"],
    target: {
        linux: {
            srcs: [
                ":boringssl_crypto_asm",
                ":boringssl_test_support_asm",
            ],
        },
        darwin: {
            cflags: ["-DOPENSSL_NO_ASM"],
        },
        windows: {
            cflags: ["-DOPENSSL_NO_ASM"],
        },
    },
}

cc_defaults {
    name: "libcrypto_bcm_sources",
    srcs: [":boringssl_bcm_srcs"],
    target: {
        linux: {
            srcs: [":boringssl_bcm_asm"],
        },
        darwin: {
            cflags: ["-DOPENSSL_NO_ASM"],
        },
        windows: {
            cflags: ["-DOPENSSL_NO_ASM"],
        },
    },
}

cc_defaults {
    name: "libssl_sources",
    srcs: [":boringssl_ssl_srcs"],
}

cc_defaults {
    name: "bssl_sources",
    srcs: [":boringssl_bssl_srcs"],
}

cc_defaults {
    name: "boringssl_test_support_sources",
    srcs: [":boringssl_test_support_srcs"],
}

cc_defaults {
    name: "boringssl_crypto_test_sources",
    srcs: [":boringssl_crypto_test_srcs"],
    data: [":boringssl_crypto_test_data"],
}

cc_defaults {
    name: "boringssl_ssl_test_sources",
    srcs: [":boringssl_ssl_test_srcs"],
}

cc_defaults {
    name: "libpki_sources",
    srcs: [":boringssl_pki_srcs"],
}

filegroup {
    name: "boringssl_crypto_test_data",
    srcs: [
        "src/crypto/blake2/blake2b256_tests.txt",
        "src/crypto/cipher/test/*.txt",
        "src/crypto/cipher/test/nist_cavp/*.txt",
        "src/crypto/curve25519/ed25519_tests.txt",
        "src/crypto/curve25519/ed25519ph_tests.txt",
        "src/crypto/ecdh/ecdh_tests.txt",
        "src/crypto/evp/test/*.txt",
        "src/crypto/fipsmodule/aes/aes_tests.txt",
        "src/crypto/fipsmodule/bn/test/*.txt",
        "src/crypto/fipsmodule/cmac/cavp_3des_cmac_tests.txt",
        "src/crypto/fipsmodule/cmac/cavp_aes128_cmac_tests.txt",
        "src/crypto/fipsmodule/cmac/cavp_aes192_cmac_tests.txt",
        "src/crypto/fipsmodule/cmac/cavp_aes256_cmac_tests.txt",
        "src/crypto/fipsmodule/ec/ec_scalar_base_mult_tests.txt",
        "src/crypto/fipsmodule/ec/p256-nistz_tests.txt",
        "src/crypto/fipsmodule/ecdsa/ecdsa_sign_tests.txt",
        "src/crypto/fipsmodule/ecdsa/ecdsa_verify_tests.txt",
        "src/crypto/fipsmodule/keccak/keccak_tests.txt",
        "src/crypto/fipsmodule/rand/ctrdrbg_vectors.txt",
        "src/crypto/fipsmodule/rand/ctrdrbg_df_vectors.txt",
        "src/crypto/hmac/hmac_tests.txt",
        "src/crypto/hpke/*.txt",
        "src/crypto/mldsa/mldsa_nist_keygen_44_tests.txt",
        "src/crypto/mldsa/mldsa_nist_keygen_65_tests.txt",
        "src/crypto/mldsa/mldsa_nist_keygen_87_tests.txt",
        "src/crypto/mldsa/mldsa_nist_siggen_44_tests.txt",
        "src/crypto/mldsa/mldsa_nist_siggen_65_tests.txt",
        "src/crypto/mldsa/mldsa_nist_siggen_87_tests.txt",
        "src/crypto/mlkem/mlkem1024_decap_tests.txt",
        "src/crypto/mlkem/mlkem1024_encap_tests.txt",
        "src/crypto/mlkem/mlkem1024_keygen_tests.txt",
        "src/crypto/mlkem/mlkem1024_nist_decap_tests.txt",
        "src/crypto/mlkem/mlkem1024_nist_keygen_tests.txt",
        "src/crypto/mlkem/mlkem768_decap_tests.txt",
        "src/crypto/mlkem/mlkem768_encap_tests.txt",
        "src/crypto/mlkem/mlkem768_keygen_tests.txt",
        "src/crypto/mlkem/mlkem768_nist_decap_tests.txt",
        "src/crypto/mlkem/mlkem768_nist_keygen_tests.txt",
        "src/crypto/pkcs7/test/*.p7c",
        "src/crypto/pkcs7/test/*.p7s",
        "src/crypto/pkcs7/test/*.pem",
        "src/crypto/pkcs8/test/*.p12",
        "src/crypto/poly1305/poly1305_tests.txt",
        "src/crypto/rsa/test/*.pem",
        "src/crypto/siphash/siphash_tests.txt",
        "src/crypto/slhdsa/slhdsa_sha2_128s_keygen.txt",
        "src/crypto/slhdsa/slhdsa_shake_256f_keygen.txt",
        "src/crypto/slhdsa/slhdsa_sha2_128s_prehash.txt",
        "src/crypto/slhdsa/slhdsa_sha2_128s_siggen.txt",
        "src/crypto/slhdsa/slhdsa_shake_256f_siggen.txt",
        "src/crypto/slhdsa/slhdsa_sha2_128s_sigver.txt",
        "src/crypto/slhdsa/slhdsa_shake_256f_sigver.txt",
        "src/crypto/x509/test/*.pem",
        "src/crypto/x509/test/*.pk8",
        "src/crypto/x509/test/mtc/*.pem",
        "src/crypto/x509/test/mtc/*/*.pem",
        "src/crypto/x509/test/mtc/large_merkle_tree_consistency_proof_tests.txt",
        "src/crypto/x509/test/mtc/large_merkle_tree_inclusion_proof_tests.txt",
        "src/third_party/wycheproof_testvectors/*.txt",
    ],
}
